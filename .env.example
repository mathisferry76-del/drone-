# Stripe (optionnel — sans ces variables, le checkout affiche un message
# "non configuré" au lieu de planter)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PRICE_CREATOR=
NEXT_PUBLIC_STRIPE_PRICE_PRO=

# OpenAI (amélioration IA générative — fallback si GEMINI_API_KEY n'est
# pas configurée, et toujours utilisé pour la retouche ciblée d'une zone)
OPENAI_API_KEY=

# Gemini (amélioration IA générative — fournisseur préféré quand configuré,
# meilleure fidélité au visage en pratique que gpt-image-1 seul)
# Clé sur aistudio.google.com — nécessite la facturation activée sur le
# projet Google Cloud associé (le palier gratuit a un quota de 0 pour la
# génération d'images).
GEMINI_API_KEY=

# fal.ai / FLUX.1 Kontext [Max] (insertion d'objet réaliste sur /impress
# uniquement — prioritaire sur ce point d'entrée dès que configurée, avant
# OpenAI et Gemini). Clé + facturation pay-as-you-go sur fal.ai/dashboard.
FAL_KEY=

# Replicate / FLUX.1 Kontext [Max] (même modèle que ci-dessus, juste hébergé
# ailleurs — utilisé sur /impress uniquement si FAL_KEY n'est pas configurée).
# Clé + facturation pay-as-you-go sur replicate.com/account/api-tokens.
REPLICATE_API_TOKEN=

# Google Ads — balise de suivi des conversions (optionnel, ex: AW-18420809148)
NEXT_PUBLIC_GOOGLE_ADS_ID=

# YouTube Data API v3 (optionnel) — sans cette clé, le champ "coller un
# lien YouTube" sur /generate fonctionne quand même (via oEmbed, sans clé)
# mais ne récupère que le titre de la vidéo, pas la description.
YOUTUBE_API_KEY=
